{
  "name": "ringivo",
  "version": "0.0.1",
  "description": "Ringivo API client for TypeScript/JavaScript",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsup src/index.ts --format esm,cjs --dts", "test": "vitest run" },
  "devDependencies": { "tsup": "^8", "typescript": "^5", "vitest": "^3" }
}
